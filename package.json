{
  "name": "test-svebble-neon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "prebuild": "npm run lint",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "call-script": "tsx --no-cache --permission --allow-fs-read=* --allow-fs-write=. --allow-child-process --allow-worker",
    "call-script:dev": "cross-env NODE_ENV=development npm run call-script --",
    "call-script:prod": "cross-env NODE_ENV=production npm run call-script --",
    "gen-auth-patch": "npm run call-script:dev -- scripts/generate-auth-patch.ts",
    "apply-auth-patch": "npm run call-script:dev -- scripts/apply-auth-patch.ts",
    "db:g": "cross-env NODE_ENV=development drizzle-kit generate",
    "db:g-prod": "cross-env NODE_ENV=production drizzle-kit generate",
    "db:g-auth": "cross-env NODE_ENV=development better-auth generate --config ./src/server/trpc/auth.ts --output ./src/server/db/schema/__generated_do_not_use__/auth_DO_NOT_USE.ts --yes",
    "db:m": "cross-env NODE_ENV=development drizzle-kit migrate && npm run call-script:dev -- scripts/check-db-triggers.ts",
    "db:m-prod": "npm run call-script:prod -- scripts/migrate-prod.ts",
    "db:run": "docker compose -f docker/postgres-dev/compose.yaml up -d --build",
    "patch-drizzle-orm": "patch-package drizzle-orm",
    "postinstall": "patch-package",
    "add-custom-migration": "cross-env NODE_ENV=development cross-var drizzle-kit generate --custom --name=$npm_config_name"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.3",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.11.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "patch-package": "^8.0.1",
    "pg": "^8.13.1",
    "postcss": "^8.5.3",
    "prettier": "3.4.2",
    "sass": "^1.94.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/cli": "^1.4.7",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.5",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/x-date-pickers": "^8.21.0",
    "@neondatabase/serverless": "^1.0.2",
    "@reduxjs/toolkit": "^2.10.1",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "11.1.1",
    "@trpc/next": "11.1.1",
    "@trpc/react-query": "11.1.1",
    "@trpc/server": "11.1.1",
    "better-auth": "^1.4.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.41.0",
    "drizzle-zod": "0.8.3",
    "fuse.js": "^7.1.0",
    "lodash": "^4.17.21",
    "motion": "^12.23.24",
    "next": "16.0.10",
    "notistack": "^3.0.2",
    "nprogress": "^0.2.0",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.68.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "react-virtuoso": "^4.14.1",
    "superjson": "^2.2.2",
    "uuid": "^11.1.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
